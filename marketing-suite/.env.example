# Modelo do /opt/plane/.env. Nao edite a mao os segredos: o gerar-env.sh cria o .env a partir
# deste arquivo, sorteia cada valor "GERAR" no proprio servidor e grava com dono root e modo 600.

# Versao das imagens oficiais. Trocar = atualizar o Plane (ver LEIA-ME, "Atualizar").
APP_RELEASE=v1.4.2

APP_DOMAIN=tarefas.marketingsuite.online
LISTEN_LOCAL_PORT=8098

# Tamanho maximo de anexo, em bytes (5 MB). O nginx do CloudPanel tambem precisa aceitar.
FILE_SIZE_LIMIT=5242880

SECRET_KEY=GERAR
LIVE_SERVER_SECRET_KEY=GERAR
POSTGRES_PASSWORD=GERAR
RABBITMQ_PASSWORD=GERAR
AWS_ACCESS_KEY_ID=GERAR
AWS_SECRET_ACCESS_KEY=GERAR
